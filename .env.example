# ==============================================================================
# KAZI CANVAS GALLERY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to `.env.local` for local development.
# 2. In cPanel (Setup Node.js App -> Environment variables), add these keys.
# 3. NEVER commit real secret values, passwords, or service-role keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CONFIGURATION (Exposed to browser client code)
# ------------------------------------------------------------------------------
# The public base URL of your deployed website (with https://)
NEXT_PUBLIC_SITE_URL=https://kazicanvasgallery.com

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Publishable Key (Safe for client browsers, restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Alternative publishable key name supported by Supabase v2
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (STRICTLY PRIVATE — NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Used exclusively by server actions/APIs for admin invoice signing and approvals)
# NEVER share this or prefix it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here


# ------------------------------------------------------------------------------
# 3. RUNTIME SETTINGS & SESSION SECURITY
# ------------------------------------------------------------------------------
# Node environment (production on cPanel)
NODE_ENV=production

# Application listening port (cPanel Passanger assigns PORT automatically, fallback 3000)
PORT=3000

# Admin session duration in seconds (default: 30 days = 2592000 seconds)
ADMIN_SESSION_MAX_AGE_SECONDS=2592000
